#!/bin/sh /etc/rc.common
# NanoPi R4S PWM fan control daemon

START=15
STOP=90
USE_PROCD=1

start_service() {
	procd_open_instance fanctl
	procd_set_param command /usr/sbin/fanctl.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# leave the fan at 100% when the daemon stops so the board stays safe
	echo 50000 > /sys/class/pwm/pwmchip1/pwm0/duty_cycle 2>/dev/null
}
